# Esempio: copiare in .env.local e inserire i valori SOLO sul dispositivo/server.
# NON committare .env.local nel repository.

# --- Supabase (opzionale: senza, l'app gira in MODALITÀ DEMO LOCALE nel browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Non usata dal codice della Fase A. Mai esporla al client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Anthropic (solo server) ---
ANTHROPIC_API_KEY=
# Vuoto = claude-opus-5-5. Alternative più economiche: claude-sonnet-5-5, claude-haiku-5-5
ANTHROPIC_MODEL=
# L'AI reale parte SOLO se questo flag è true (consenso esplicito alla spesa).
ENABLE_EXTERNAL_PAID_APIS=false
# Tetto di spesa AI per libro, in centesimi (default prudente lato codice: 2000)
MAX_AI_SPEND_CENTS_PER_BOOK=2000
# Senza Supabase le route AI non hanno autenticazione: consentire l'AI reale
# solo in locale/ambiente privato impostando true.
ALLOW_UNAUTHENTICATED_AI=false

# --- Rendering PDF / copertine ---
# Percorso di Chrome/Chromium. Se vuoto vengono provati i percorsi di sistema più comuni.
CHROMIUM_EXECUTABLE_PATH=

# --- Provider opzionali (Fase B/C, non usati nella Fase A) ---
KEEPA_API_KEY=
GOOGLE_TRENDS_API_KEY=
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
ENABLE_AMAZON_ADS_LIVE=false
